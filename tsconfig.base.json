{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@applyocalypse/shared-types": ["packages/shared-types/src/index.ts"],
      "@applyocalypse/shared-schemas": ["packages/shared-schemas/src/index.ts"],
      "@applyocalypse/ipc-contracts": ["packages/ipc-contracts/src/index.ts"],
      "@applyocalypse/db": ["packages/db/src/index.ts"],
      "@applyocalypse/validator": ["packages/validator/src/index.ts"],
      "@applyocalypse/config": ["packages/config/src/index.ts"],
      "@applyocalypse/logging": ["packages/logging/src/index.ts"],
      "@applyocalypse/document-tools": ["packages/document-tools/src/index.ts"],
      "@applyocalypse/ui": ["packages/ui/src/index.ts"]
    }
  }
}
