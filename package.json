{
  "name": "applyocalypse",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop copilot for human-controlled job applications.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm python:ensure && pnpm native:rebuild:electron && pnpm --filter @applyocalypse/desktop dev",
    "build": "pnpm -r build",
    "python:build": "node scripts/build/build-python-worker.mjs",
    "python:ensure": "node scripts/dev/ensure-python-env.mjs",
    "desktop:package": "pnpm python:build && pnpm --filter @applyocalypse/desktop build && node scripts/build/package-desktop.mjs",
    "typecheck": "pnpm -r --stream typecheck",
    "test": "pnpm native:rebuild:node && vitest run",
    "test:coverage": "pnpm native:rebuild:node && vitest run --coverage",
    "test:python": "node scripts/test/python-tests.mjs",
    "test:desktop-smoke": "pnpm native:rebuild:electron && node scripts/test/desktop-boot-smoke.mjs",
    "test:desktop-user-flow": "pnpm native:rebuild:electron && node scripts/test/desktop-user-flow-smoke.mjs",
    "test:desktop-e2e": "pnpm native:rebuild:electron && node scripts/test/desktop-full-e2e-smoke.mjs",
    "test:worker-smoke": "node scripts/test/packaged-worker-smoke.mjs",
    "python:audit": "node scripts/test/python-audit.mjs",
    "native:rebuild": "pnpm native:rebuild:electron",
    "native:rebuild:electron": "node scripts/dev/rebuild-native.mjs electron",
    "native:rebuild:node": "node scripts/dev/rebuild-native.mjs node",
    "cert:portals": "node scripts/certification/live-portal-certification.mjs",
    "cert:providers": "node scripts/certification/byok-provider-matrix.mjs",
    "release:preflight": "node scripts/release/preflight.mjs",
    "verify": "pnpm verify:functional && pnpm audit --audit-level high",
    "verify:functional": "pnpm typecheck && pnpm lint:js && pnpm lint:python && pnpm landing:check && pnpm test && pnpm test:python && pnpm python:audit",
    "verify:packaged": "pnpm desktop:package && pnpm test:worker-smoke && pnpm test:desktop-smoke && pnpm test:desktop-user-flow && pnpm test:desktop-e2e",
    "lint": "pnpm -r lint",
    "lint:js": "eslint .",
    "lint:python": "node scripts/test/python-lint.mjs",
    "landing:check": "node scripts/landing/check-assets.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @applyocalypse/db migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9.39.1",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "tmp": ">=0.2.6",
      "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "electron-vite>vite": "8"
      }
    }
  }
}
